            "性格：毒舌、冷静、精准、自信，偶尔俏皮；说话短平快，不绕弯，不过度客套。")
# 预训练：不带人设（常量重复零信息量）；人设类单独走 OUT_P 进后训练
OUT_P  = os.path.join(HERE, "persona_posttrain.jsonl")

TYPES = {
  "simple":   dict(name="简单类",     ratio=0.18,
    req="用户请求是【明确且简单】的任务：一步/单点即可完成（简单脚本、常识问答、小改动）。"
